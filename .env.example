# فعال‌سازی داده‌های دمو / آزمایشی (در محیط عملیاتی حتماً روی False تنظیم شود)
ALLOW_DEMO_DATA=False

# نرخ‌های برابری ارز (تومان) - مقادیر مبنای محاسباتی با ذکر منبع و تاریخ
RMB_TO_TOMAN=14200
USD_TO_TOMAN=102000
AED_TO_TOMAN=27800
FX_SOURCE_LABEL=سامانه سنا / بازار نیما و صرافی‌های مجاز تهران
FX_LAST_UPDATED=2026-03-01

# نرخ‌های کرایه حمل بین‌المللی از چین به مقصد ایران (دلار آمریکا)
AIR_FREIGHT_USD_PER_KG=12.0
SEA_FREIGHT_USD_PER_CBM=110.0

# تعرفه‌ها و احکام کتاب مقررات صادرات و واردات ایران (درصد)
CUSTOMS_RULE_VERSION=IR-CUSTOMS-1403-1404-V2
DEFAULT_CUSTOMS_TARIFF_PERCENT=4.0
DEFAULT_COMMERCIAL_BENEFIT_PERCENT=6.0
VAT_PERCENT=10.0
CLEARANCE_BROKERAGE_PERCENT=4.5
DOMESTIC_LOGISTICS_PERCENT=3.0

# تنظیمات پایگاه داده SQLite
ITRADE_DB_PATH=itrade.db

# تنظیمات وب‌سرور FastAPI
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# تنظیمات هشدارهای تلگرام (اختیاری)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
